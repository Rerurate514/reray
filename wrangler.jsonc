{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reray",
  "main": "./dist/index.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reray",
      "database_id": "local-reray",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "reray-83ad4",
    "PUBLIC_FIREBASE_AUTH_DOMAIN": "reray-83ad4.firebaseapp.com",
    "PUBLIC_FIREBASE_PROJECT_ID": "reray-83ad4"
  }
  // "vars": {
