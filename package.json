{
  "name": "reray",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "preview": "wrangler dev",
    "preview:remote": "wrangler dev --remote",
    "db:migrate:local": "wrangler d1 migrations apply reray --local",
    "db:migrate:remote": "wrangler d1 migrations apply reray --remote",
    "deploy": "pnpm run build && wrangler deploy",
    "deb": "pnpm run build && pnpm run preview"
  },
  "private": true,
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "firebase": "^12.19.0",
    "hono": "^4.13.8",
    "honox": "0.1.61",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20260712.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.2",
    "drizzle-kit": "^0.31.8",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.110.0"
  }
}
